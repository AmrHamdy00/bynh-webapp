{
  "name": "bynh-web",
  "version": "1.0.0",
  "private": true,
  "description": "bynh.sa — Next.js app: public site (cached HTML) + admin dashboard (admin.bynh.sa) on PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
