    "seo:compare": "node scripts/seo/compare.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.5",
    "gsap": "3.12.5",
    "next": "15.5.29",
    "otplib": "^12.0.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "5.8.3"
