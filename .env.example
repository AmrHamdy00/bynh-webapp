# Copy to .env.local (development) or .env.production (server). Never commit the real files.

# PostgreSQL. Production: a dedicated role with a long random password, listening on localhost only.
DATABASE_URL=postgres://bynh:bynh_dev_pw@127.0.0.1:5432/bynh

# 48+ random bytes: `openssl rand -base64 48`. Encrypts authenticator secrets and signs previews/analytics ids.
# Changing it invalidates every enrolled authenticator — keep it safe and backed up.
APP_SECRET=

# Public origin (canonical URLs, sitemap, Open Graph). Keep https://bynh.sa even locally so SEO tests compare equal.
SITE_URL=https://bynh.sa
# Where the admin's "preview"/"view" buttons open the public site (local: http://localhost:3000).
PUBLIC_ORIGIN=https://bynh.sa

# Uploaded media (served at /wp-content/uploads/…). Production: /var/lib/bynh/uploads
UPLOAD_DIR=./storage/uploads

# 1 only when the app listens on 127.0.0.1 behind nginx (then X-Real-IP is trusted for rate limits).
TRUST_PROXY=0
# Optional: comma-separated IPs allowed to open admin.bynh.sa (in addition to password + authenticator).
ADMIN_ALLOWED_IPS=

# Only for the one-time import from the old WordPress.
WP_API_URL=https://bynh.sa/wp-json/wp/v2

NEXT_TELEMETRY_DISABLED=1

# ── Test copies (e.g. Vercel staging) ──
# 1 = noindex everywhere + robots.txt disallow all. Never set on the real bynh.sa.
STAGING=
# Files missing from UPLOAD_DIR are redirected here (e.g. https://bynh.sa) instead of 404.
MEDIA_FALLBACK_ORIGIN=
# Dashboard host when admin.* subdomains aren't available (e.g. bynh-admin-staging.vercel.app).
ADMIN_HOST=
# Vercel Blob for uploads (no persistent disk on Vercel); set automatically when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# First deploy only: create this admin when the users table is empty (temporary password in the build log).
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_NAME=
# Staging only (ignored unless STAGING=1): skip the authenticator + forced password change, and set the admin's
# password on every build. Never set these on the real site.
AUTH_DISABLE_2FA=
STAGING_ADMIN_USER=
STAGING_ADMIN_PASSWORD=
