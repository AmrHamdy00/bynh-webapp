# Copy to .env.production on the server (and .env.local for development).

# WordPress REST API that feeds the blog at build time.
# Today (before the switch):  https://bynh.sa/wp-json/wp/v2
# After the switch:           https://cms.bynh.sa/wp-json/wp/v2
WP_API_URL=https://cms.bynh.sa/wp-json/wp/v2

# Where /wp-content/ images are loaded from.
# Production: leave EMPTY — nginx proxies /wp-content/ to the CMS, so image URLs stay on bynh.sa.
# Local preview: https://cms.bynh.sa (or https://bynh.sa before the switch)
WP_MEDIA_ORIGIN=

# Public site origin for canonical URLs, Open Graph, sitemap.
SITE_URL=https://bynh.sa

NEXT_TELEMETRY_DISABLED=1
