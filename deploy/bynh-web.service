# /etc/systemd/system/bynh-web.service — runs the Next.js app on 127.0.0.1:3000 (only nginx can reach it).
[Unit]
Description=bynh.sa web (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=bynh
Group=bynh
WorkingDirectory=/opt/bynh-web
EnvironmentFile=/opt/bynh-web/.env.production
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3000 TRUST_PROXY=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bynh-web/.next /var/lib/bynh/uploads
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
